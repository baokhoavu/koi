{
  "name": "cfkoi-web-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "build": "del-cli public/js/app && webpack --config webpack.config.dev.js --progress --profile",
    "build:prod": "del-cli public/js/app && ngc -p tsconfig.aot.json && ngc -p tsconfig.aot.json && webpack --config webpack.config.prod.js --progress --profile --bail && del-cli 'public/js/app/**/*.js' 'public/js/app/**/*.js.map' '!public/js/app/bundle.js' '!public/js/app/*.chunk.js' 'assets/app/**/*.ngfactory.ts' 'assets/app/**/*.shim.ts' 'assets/app/**/*.ngsummary.json' 'assets/app/**/*.ngstyle.ts'",
    "format": "prettier --write \"**/*.{js,ts}\" --ignore-path \".gitignore\"",
    "format:check": "prettier --check \"**/*.{js,ts}\" --ignore-path \".gitignore\""
  },
  "dependencies": {
    "@angular/animations": "^21.0.4",
    "@angular/cdk": "^21.0.3",
    "@angular/common": "^21.0.4",
    "@angular/compiler": "^21.0.4",
    "@angular/compiler-cli": "^21.0.4",
    "@angular/core": "^21.0.4",
    "@angular/forms": "^21.0.4",
    "@angular/material": "^21.0.3",
    "@angular/material-moment-adapter": "^21.0.3",
    "@angular/platform-browser": "^21.0.4",
    "@angular/platform-browser-dynamic": "^21.0.4",
    "@angular/router": "^21.0.4",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "bluebird": "^3.5.5",
    "body-parser": "^1.18.3",
    "cookie-parser": "~1.4.3",
    "core-js": "^3.39.0",
    "dotenv": "^16.4.0",
    "express": "^4.16.3",
    "hammerjs": "^2.0.8",
    "hbs": "^4.2.0",
    "jquery": "^3.4.1",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.21.0",
    "mongoose": "^8.8.3",
    "mongoose-unique-validator": "^5.0.1",
    "morgan": "^1.9.1",
    "rxjs": "^7.8.1",
    "serve-favicon": "^2.5.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@types/core-js": "^2.5.8",
    "angular-router-loader": "^0.8.5",
    "angular2-template-loader": "^0.6.2",
    "del-cli": "^7.0.0",
    "file-loader": "^6.2.0",
    "html-loader": "^5.1.0",
    "prettier": "^3.7.4",
    "raw-loader": "^4.0.2",
    "sass": "^1.96.0",
    "sass-loader": "^16.0.6",
    "ts-loader": "^9.5.4",
    "typescript": "~5.9.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^4.1.1"
  }
}
