# MongoDB Configuration
MONGODB_URI=mongodb://username:password@host:port/database

# API URLs
API_CONQUERCANCER_CA=http://www.conquercancer.ca/site/PageServer?pagename=2018_api_data&pgwrap=n
API_ONEWALK_CA=http://secure.weekendtoconquercancer.ca/site/PageServer?pagename=api_data&pgwrap=n
API_CONQUERCANCER_AU=http://www.conquercancer.org.au/site/PageServer?pagename=api_data&pgwrap=n
API_ONEDAY_AU=http://participate.theoneday.org.au/site/PageServer?pagename=api_data&pgwrap=n

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend API Base URL (Development)
API_BASE_URL=http://localhost:3000

# Production API URL
PROD_API_URL=https://your-app.herokuapp.com

# mLab API Configuration (if still used - note: mLab is deprecated, migrate to MongoDB Atlas)
MLAB_API_URL=https://api.mlab.com/api/1/databases/your_db/collections/your_collection
MLAB_API_KEY=your_mlab_api_key

# Optional: Proxy Configuration (if needed)
# FIXIE_URL=http://your-proxy-url

# Mock Login Credentials (for development without MongoDB)
# These credentials are used when MongoDB is not available
# SECURITY NOTE: Only use in development! Never commit real credentials to .env
MOCK_USER_EMAIL=admin@koi.com
MOCK_USER_PASSWORD=koi2025
